# ---------------------------------------------------------------------------
# TokenTrim environment variables
#
# Copy this file to `.env.local` (web) and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
#
#   Project URL      -> NEXT_PUBLIC_SUPABASE_URL
#   anon / public key-> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# These are PUBLIC keys and are safe to ship in the browser and in the desktop
# app: every table is protected by Row Level Security (see supabase/schema.sql),
# so the anon key can only ever read the signed-in user's own rows.
#
# The app is fully functional WITHOUT these variables - compression runs
# locally and history is kept in localStorage. Add them to enable accounts and
# cloud sync of the Dashboard.
#
# NEVER put the `service_role` key here. It bypasses RLS and must only ever
# live in a trusted server environment.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# OPTIONAL, server-only (never a NEXT_PUBLIC_ prefix): enables the server-side
# sign-up route (app/api/auth/signup - creates accounts already confirmed, so
# no confirmation email), the system audit log and the /admin APIs. Without it
# the app still works; sign-up falls back to the public client-side path.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
